# Build outputs
.next
.next-empty
node_modules
tsconfig.tsbuildinfo

# Environment
.env
.env.local

# Python
__pycache__
*.pyc
.pytest_cache

# Test artifacts
test-results
playwright-report

# Runtime
tmp
uploads
dev-server*.log
pipeline-sidecar*.log
# dev-inspector source-location log (scratch, regenerated each dev run)
.inspect-dev.log
*.inspect-dev.log

# Local tooling
.claude/logs
.claude/worktrees

# Persistence
data/*.sqlite
data/*.sqlite-wal
data/*.sqlite-shm
# Workspace dumps (npm run db:dump) — share/seed them out-of-band, don't commit
data/dumps/

# Stray tooling artifacts
# cygwin/msys crash dumps (e.g. grep.exe.stackdump)
*.stackdump
# Windows %TEMP% paths that lost their separators
*AppDataLocalTemp*
# mangled tmp\kp_*.json etc. written to the repo root
tmpkp_*
data/piper/

# Personas app local state (outbox + registered-context list)
.personas/
