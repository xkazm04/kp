# Build outputs
.next
.next-empty
node_modules
tsconfig.tsbuildinfo

# Environment
.env
.env.local

# Python
__pycache__
*.pyc
.pytest_cache

# Test artifacts
test-results
playwright-report

# Runtime
tmp
uploads
dev-server*.log
pipeline-sidecar*.log
# dev-inspector source-location log (scratch, regenerated each dev run)
.inspect-dev.log
*.inspect-dev.log

# Local tooling
.claude/logs
.claude/worktrees

# Persistence
data/*.sqlite
data/*.sqlite-wal
data/*.sqlite-shm
# Workspace dumps (npm run db:dump) — share/seed them out-of-band, don't commit
data/dumps/

# Stray tooling artifacts
# cygwin/msys crash dumps (e.g. grep.exe.stackdump)
*.stackdump
# Windows %TEMP% paths that lost their separators
*AppDataLocalTemp*
# mangled tmp\kp_*.json etc. written to the repo root
tmpkp_*
data/piper/

# Personas app local state (outbox + registered-context list)
.personas/

# /uat — the simulated-UAT harness overlay (characters, journeys, drivers) and its
# per-run artifacts (findings, reports, shots). Kept local by request (2026-08-18):
# runs are bulky and session-specific, and re-committing every run was spamming the
# tree. The durable outcomes of a run live in docs/product/uat-insights/ and
# docs/BACKLOG.md, which stay tracked.
/uat/

# --- Internal working material, untracked when the repo went public (AGPL) -----
# All of this stays on the maintainer's disk and out of the published tree. It is
# working material, not product: dated scan evidence, harness vaults, competitive
# strategy and the ship-loop's business state. Same rule as /uat above — the
# DURABLE outcome of any of these belongs in docs/features, docs/architecture or
# docs/BACKLOG.md, which stay tracked.
#
# NOTE: these paths remain in the git HISTORY of commits made before this line.
# A history rewrite is a separate, deliberate decision.
/docs/harness/
/casesim/
/tiger/
/.claude/ship-loop/
/docs/product/competitor-talentpilot.md
/docs/product/coverage-plan.md

# /bench — App-master mass-test driver artifacts (scripts/app-master-bench).
# Same rule as /uat above: runs are bulky, per-machine and per-session. The
# DURABLE outcome of a bench sweep belongs in docs/features/app-master/README.md
# or docs/BACKLOG.md, which stay tracked. The committed fixture the report tests
# render lives in scripts/app-master-bench/__fixtures__/, not here.
/bench/

# /consult skill log (counts reach the ai-registry signals lane; the log itself stays local)
.ai/consults.jsonl

