# Copy to .env (gitignored) and fill in. Restart the dev server after changes.

# Public site origin for absolute OG/Twitter image URLs and the canonical
# metadataBase (app/layout.tsx). OPTIONAL — defaults to https://nuda.dev when
# unset. Set this per deploy to YOUR origin so shared links don't advertise the
# wrong domain. Must be a valid absolute URL (scheme + host); a malformed value is
# logged and ignored (the default is used) rather than crashing the app at boot.
NEXT_PUBLIC_SITE_URL=https://nuda.dev

# Public origin for CANDIDATE-FACING links — offer, voice-screen, self-scheduling
# and apply URLs that get sent to external candidates (resolved through
# app/_lib/public-base-url.ts). OPTIONAL — defaults to the live request/window
# origin when unset. Set this per deploy to your PUBLIC host so links don't break
# behind a proxy or when a recruiter works on localhost while candidates need a
# public host. Precedence: APP_BASE_URL (server-only) ▸ NEXT_PUBLIC_APP_BASE_URL
# (the browser-visible mirror) ▸ request/window origin.
#   • NEXT_PUBLIC_APP_BASE_URL is the canonical knob: it is the only one Next.js
#     exposes to the client bundle, so it must be set for the client-built links
#     (voice/scheduling/apply) to honor it. Read on BOTH sides.
#   • APP_BASE_URL is honored server-side for backward compatibility and outranks
#     the mirror there; set it to the SAME value if you use it at all.
# Separate from NEXT_PUBLIC_SITE_URL above (that one is only for OG/metadata).
NEXT_PUBLIC_APP_BASE_URL=
# APP_BASE_URL=

# Sales contact for the Enterprise (contact-sales) tier — the "Talk to sales" CTA
# on the landing pricing band and the Billing tab's Enterprise card open a mailto:
# to this address (app/_lib/sales-contact.ts). OPTIONAL — defaults to a placeholder
# (sales@kandidate.app); set it per deploy so enterprise enquiries actually reach you.
NEXT_PUBLIC_SALES_EMAIL=

# Gemini API key — gates the flagship CV-analysis pipeline (Analyze/Match tabs,
# CLI scripts, eval harness) and the GitHub repo-signal review. Without it, CV
# analysis fails loudly and github-analysis returns an error status.
# GOOGLE_API_KEY is honored as an alias.
GEMINI_API_KEY=

# GitHub API token for the GitHub repo analysis feature — raises the anonymous
# rate limit (60/hr). Optional; analysis degrades to rate-limit messaging without it.
GITHUB_TOKEN=

# --- Voice interview MVP (/interview-lab) — fill these, then RESTART the dev server.
# OpenAI Realtime (browser WebRTC):
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
# ElevenLabs Agents — create a multilingual (Czech-capable) agent in their
# dashboard and paste its id here:
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=

# --- Multi-provider LLM layer (docs/LLM_PROVIDER_LAYER.md) -------------------
# Master secret for encrypting UI-entered provider keys at rest (AES-256-GCM).
# Required before saving keys via /api/llm/keys; any string works.
KP_SECRET=
# Optional LLM observability — LightTrack (sibling repo ../LightTrack):
#   pip install ../LightTrack/clients/python   then point at your instance.
LIGHTTRACK_URL=
# LIGHTTRACK_KEY=
# LIGHTTRACK_PROJECT=

# --- Payment gate — Polar (docs/BILLING.md) ----------------------------------
# Organization Access Token from the Polar dashboard (Settings → Developers).
# Leave empty to run unbilled (local-first default; all billing routes 503).
POLAR_ACCESS_TOKEN=
# sandbox (default) until the end-to-end checklist in docs/BILLING.md passes.
POLAR_SERVER=sandbox
# Webhook endpoint secret (whsec_…) from registering /api/billing/webhook.
POLAR_WEBHOOK_SECRET=
# Product ids created in Polar (3 subscriptions + 1 one-time minute pack):
POLAR_PRODUCT_STARTER=
POLAR_PRODUCT_GROWTH=
POLAR_PRODUCT_BYOM=
POLAR_PRODUCT_MINUTE_PACK=

# --- Self-hosting / deployment (docs/SELF_HOSTING.md) ------------------------
# For running KP in YOUR own environment (Docker / VPC / on-prem) with full
# control of the data + model layer. See docs/SELF_HOSTING.md for the compose
# quick-start, the complete external-egress inventory, and air-gap guidance.
#
# OPERATOR PASSWORD — REQUIRED IN PRODUCTION. Leave this UNSET and the app runs
# fully OPEN: every operator route is reachable with no login (open dev mode,
# app/_lib/auth/require-operator.ts). Set a strong value before exposing KP to
# anyone; the fail-closed proxy then gates every non-public route.
KP_OPERATOR_PASSWORD=
# SQLite database file (all app data + candidate PII). REQUIRED to be an ABSOLUTE
# path in any deploy — the default is derived from the launch directory and a
# service/cron launched from elsewhere silently opens a DIFFERENT, empty DB
# (app/_lib/db-path.ts). The Docker image sets this to /data/kp.sqlite (a volume).
KP_DB_PATH=
# Host port the container publishes (docker-compose maps ${KP_PORT}:3000).
KP_PORT=3000
# Python interpreter the app spawns for the jobfit pipeline. The Docker image sets
# this to its venv (/opt/venv/bin/python); only override on a bespoke host.
# PYTHON_CMD=python3
# Next.js telemetry is disabled in the image; set here too for bare-metal runs.
NEXT_TELEMETRY_DISABLED=1
# Self-hosted / in-VPC inference (docs/SELF_HOSTING.md §5): point the OpenAI adapter
# at an OpenAI-compatible endpoint on your own network — Azure OpenAI, vLLM, Ollama
# (http://ollama:11434/v1), LiteLLM, a proxy — so model calls never leave your
# boundary. Then route use cases to the `openai` provider in Settings → Models.
# Runs KEYLESS against endpoints that need no key (vLLM/Ollama); set OPENAI_API_KEY
# above only if yours enforces one. Leave blank to use api.openai.com.
# OPENAI_BASE_URL=http://ollama:11434/v1
