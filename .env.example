# Copy to .env (gitignored) and fill in. Restart the dev server after changes.

# Public site origin — OG/Twitter image URLs, the canonical metadataBase and the
# sitemap all derive from it (app/layout.tsx). OPTIONAL — the code falls back to
# the project's own domain (https://nuda.dev) when unset, which is almost never
# YOUR deploy: set it to your real origin so shared links and crawlers don't
# advertise someone else's domain. Must be a valid absolute URL (scheme + host);
# a malformed value is logged and ignored (the fallback is used) rather than
# crashing the app at boot.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Public origin for CANDIDATE-FACING links — offer, voice-screen, self-scheduling
# and apply URLs that get sent to external candidates (resolved through
# app/_lib/public-base-url.ts). OPTIONAL — defaults to the live request/window
# origin when unset. Set this per deploy to your PUBLIC host so links don't break
# behind a proxy or when a recruiter works on localhost while candidates need a
# public host. Precedence: APP_BASE_URL (server-only) ▸ NEXT_PUBLIC_APP_BASE_URL
# (the browser-visible mirror) ▸ request/window origin.
#   • NEXT_PUBLIC_APP_BASE_URL is the canonical knob: it is the only one Next.js
#     exposes to the client bundle, so it must be set for the client-built links
#     (voice/scheduling/apply) to honor it. Read on BOTH sides.
#   • APP_BASE_URL is honored server-side for backward compatibility and outranks
#     the mirror there; set it to the SAME value if you use it at all.
# Separate from NEXT_PUBLIC_SITE_URL above (that one is only for OG/metadata).
NEXT_PUBLIC_APP_BASE_URL=
# APP_BASE_URL=

# Env-gated web analytics — Plausible (privacy-first, cookieless). Empty = off
# (the default: no script tag, no analytics egress). Set to the domain you
# registered in Plausible (e.g. app.your-domain.example) to enable; the CSP in
# next.config.ts already allows plausible.io for when this flips on. Inlined at
# BUILD time like every NEXT_PUBLIC_* var.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Sales contact for the Enterprise (contact-sales) tier — the "Talk to sales" CTA
# on the landing pricing band and the Billing tab's Enterprise card open a mailto:
# to this address (app/_lib/sales-contact.ts). OPTIONAL — defaults to a placeholder
# (sales@kandidate.app); set it per deploy so enterprise enquiries actually reach you.
NEXT_PUBLIC_SALES_EMAIL=

# --- Source (AGPL-3.0) --------------------------------------------------------
# Where this instance's source lives. Defaults to the upstream repository. If you
# MODIFY KP and offer it to others over a network, AGPL §13 requires you to offer
# those users YOUR modified source — set this to your fork and the app's footer,
# landing nav and pricing CTA all point there.
NEXT_PUBLIC_SOURCE_REPO_URL=

# Gemini API key — gates the flagship CV-analysis pipeline (Analyze/Match tabs,
# CLI scripts, eval harness) and the GitHub repo-signal review. Without it, CV
# analysis fails loudly and github-analysis returns an error status.
# GOOGLE_API_KEY is honored as an alias.
GEMINI_API_KEY=

# GitHub API token for the GitHub repo analysis feature — raises the anonymous
# rate limit (60/hr). Optional; analysis degrades to rate-limit messaging without it.
GITHUB_TOKEN=

# --- Voice interview MVP (/interview-lab) — fill these, then RESTART the dev server.
# OpenAI Realtime (browser WebRTC):
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
# ElevenLabs Agents — create a multilingual (Czech-capable) agent in their
# dashboard and paste its id here:
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=
# Self-hosted voice: the Agents API is a protocol, not a company, so this path
# can point at a service you run. Gravitone serves the same endpoints from
# CPU-only speech-to-text + text-to-speech (github.com/xkazm04/gravitone):
#   ELEVENLABS_BASE_URL=http://127.0.0.1:8080
#   ELEVENLABS_AGENT_ID=local-interviewer
#   ELEVENLABS_API_KEY=local
# A loopback/private host here means the session is free, so the per-minute
# billing meter and the paid-credit connect throttle both step aside. Leave it
# unset to use ElevenLabs. See app/_lib/voice/self-hosted.ts.
ELEVENLABS_BASE_URL=

# --- Multi-provider LLM layer (docs/architecture/llm-provider-layer.md) -------------------
# Master secret for encrypting UI-entered provider keys at rest (AES-256-GCM).
# Required before saving keys via /api/llm/keys; any string works.
KP_SECRET=
# Optional LLM observability — LightTrack (sibling repo ../LightTrack).
# Local-dev wiring (one-time): pip install -e ../LightTrack/clients/python
# Each session: start the server with  pwsh scripts/lighttrack-dev.ps1  (dev
# auth mode, SQLite, 127.0.0.1:8787), then fill the two vars below with
#   LIGHTTRACK_URL=http://127.0.0.1:8787   and   LIGHTTRACK_PROJECT=kp
# Monitoring in pipeline/jobfit/llm/monitor.py activates ONLY when
# LIGHTTRACK_URL is set (left empty here so a copied .env stays off by
# default); every kp call lands tagged use_case:<name> under LIGHTTRACK_PROJECT.
LIGHTTRACK_URL=
LIGHTTRACK_PROJECT=
# LIGHTTRACK_KEY=   # only in the server's "enforced" auth mode (not local dev)

# --- Error reporting — Sentry (OPTIONAL, off by default) ---------------------
# Same gating philosophy as LightTrack above: unset = no init, no SDK load, no
# egress. KP_OFFLINE=1 skips Sentry entirely even when a DSN is set.
# Server-side reporting (API routes, RSC render errors, the scheduler clock):
SENTRY_DSN=
# Browser-side reporting (route error boundaries, the root crash screen).
# NEXT_PUBLIC_* is inlined at BUILD time — set this when BUILDING the image;
# a runtime-only value cannot reach an already-built client bundle.
NEXT_PUBLIC_SENTRY_DSN=

# --- Payment gate — Polar (docs/features/billing/README.md) ----------------------------------
# ONLY needed to run KP *as a paid service*. A self-hosted install leaves this whole
# block empty: with no billing provider configured (and no billing history) NOTHING
# is metered — every allowance resolves unlimited and no gate ever fires. See
# app/_lib/billing/mode.ts. Setting POLAR_ACCESS_TOKEN is what turns metering ON.
#
# Organization Access Token from the Polar dashboard (Settings → Developers).
POLAR_ACCESS_TOKEN=
# sandbox (default) until the end-to-end checklist in docs/features/billing/README.md passes.
POLAR_SERVER=sandbox
# Webhook endpoint secret (whsec_…) from registering /api/billing/webhook.
POLAR_WEBHOOK_SECRET=
# Product ids created in Polar (2 subscriptions + 1 one-time minute pack):
POLAR_PRODUCT_STARTER=
POLAR_PRODUCT_GROWTH=
POLAR_PRODUCT_MINUTE_PACK=
# BYOM is WITHDRAWN FROM SALE (self-hosting gives away what it sold). Keep the id
# set only if you have existing BYOM subscribers — the reducer still maps it so they
# keep their entitlement; it is no longer provisioned or offered.
POLAR_PRODUCT_BYOM=

# --- Candidate communications & inbound channels (docs/COMMS_DELIVERY.md) ----
# Outbound relay for candidate email (acknowledgements, invites, offers…). Leave
# empty and every message is recorded terminal `queued` in the local outbox — the
# UI says so honestly ("NOT being sent"). Set to your relay's endpoint and kp
# POSTs the kp.comm.v1 envelope there instead.
COMMS_WEBHOOK_URL=
# Shared secret for the relay's asynchronous delivery receipts (bounce/complaint/
# drop) on POST /api/comms/callback. Unset ⇒ the callback answers 503 (fail-closed).
COMMS_CALLBACK_SECRET=
# Inbound-EMAIL forwarding domain for the Email intake channel. Only set this when
# a real inbound-mail provider (Postmark/SendGrid/Mailgun inbound, or your mail
# server) routes <token>@<this domain> to POST /api/channels/inbound/<token>.
# Unset ⇒ the Email intake wizard shows the HTTP receiver URL and says forwarding
# isn't wired, instead of fabricating a mailbox nothing serves.
EMAIL_INBOUND_DOMAIN=

# --- Always-on edge (docs/concepts/local-first-edge.md, edge/README.md) ------
# WHO ANSWERS FOR THIS INSTALL WHILE IT IS SWITCHED OFF. kp is local-first: the
# database, the model keys and every decision live on this machine. Three things
# cannot wait for it to be running - an inbound webhook (the sender retries a few
# times, then gives up), a candidate email, and a delivery receipt for a bounce -
# so an optional Cloudflare Worker holds those in order until the clock next
# drains them. Deploy it to YOUR OWN account (edge/README.md); it fits the free
# plan, kp bills nothing for it and cannot see it.
#
# UNSET (the default) is a complete, honest state: inbound events reach this
# install only while it runs, which is what a local-first app is. Nothing lies
# about it - the Channels tab says "Not paired".
#
# The edge holds NO provider keys, NO calendar tokens and NO database: one shared
# HMAC secret whose whole power is "may talk to this queue", plus an append-only
# log that is DELETED as it drains. Publish a sealing key (Channels -> Edge ->
# Enable sealing) and it cannot read what it holds either.
#
# Same precedence as COMMS_WEBHOOK_URL above: env wins over the UI-stored config,
# and KP_OFFLINE=1 disables the edge entirely (air-gapped means air-gapped).
KP_EDGE_URL=
# The shared signing secret - the SAME value you set on the Worker with
# `wrangler secret put KP_EDGE_SECRET`. No secret, no drain: an unsigned drain
# would accept events from anyone who learned the URL, and those events file
# candidates and send mail.
KP_EDGE_SECRET=
# Where "your studio has mail" goes when the edge has been holding events while
# this install stayed quiet. Any endpoint that accepts a POST body; an ntfy.sh
# topic is free and needs no account on either side. Unset = the edge still holds
# and counts, it just never nudges. The nudge carries COUNTS, never names.
KP_NUDGE_TARGET=

# --- Self-hosting / deployment (docs/architecture/self-hosting.md) ------------------------
# For running KP in YOUR own environment (Docker / VPC / on-prem) with full
# control of the data + model layer. See docs/architecture/self-hosting.md for the compose
# quick-start, the complete external-egress inventory, and air-gap guidance.
#
# OPERATOR PASSWORD — REQUIRED IN PRODUCTION. Leave this UNSET and the app runs
# fully OPEN: every operator route is reachable with no login (open dev mode,
# app/_lib/auth/require-operator.ts). Set a strong value before exposing KP to
# anyone; the fail-closed proxy then gates every non-public route.
KP_OPERATOR_PASSWORD=
#
# DECISION-CHAIN HMAC KEY — what turns the sealed decision records from
# integrity-evident into tamper-RESISTANT (app/_lib/decision-record-store.ts).
# UNSET (the default) is a real, honest state, not a broken one: every record is
# still sealed into a hash chain, and that chain still catches accidental
# corruption, a deleted row or a casual edit. What it does NOT catch is an
# insider: the keyless seal is a public SHA-256 with no secret, so anyone who can
# write to decision_records can recompute every link and forge the chain. The
# Analytics → decision-records badge says exactly that when this is empty.
# Set it and each new link is an HMAC-SHA256 under a secret the database writer
# does not hold — no key, no valid link. Any string with real entropy works
# (32 bytes of hex is a good default: `openssl rand -hex 32`).
#
# THE CEILING, stated up front: turning this on cannot retro-seal records already
# written. They keep key_id '' forever. It protects everything sealed AFTER it —
# and, because each link hashes the one before it, an edit to an older keyless
# record then breaks the chain at the first keyed link, which cannot be reforged.
#
# ROTATE, NEVER REMOVE. Once a chain has keyed rows, sealing keyless again would
# be a downgrade, so the store REFUSES to append (a logged skip, not a corrupt
# chain). To rotate: pick a new id, point KP_DECISION_HMAC_KEY at the new secret
# and KP_DECISION_HMAC_KEY_ID at the new id, and keep the retired secret readable
# as KP_DECISION_HMAC_KEY_<oldId> — verify resolves each row by its stored key id,
# so history keeps verifying. Dropping a retired key makes its rows unverifiable.
# Deliberately NOT KP_SECRET: that one also signs sessions and is expected to
# rotate; an audit chain must survive an auth-secret rotation unbroken.
# KP_DECISION_HMAC_KEY=
# KP_DECISION_HMAC_KEY_ID=k1
# KP_DECISION_HMAC_KEY_k1=   # the retired secret, kept readable across a rotation
# Multi-workspace gate (app/_lib/workspace-lock.ts, multiWorkspaceEnabled).
# Default OFF: the organization runs as ONE workspace, and creating, renaming or
# switching workspaces is refused. Member administration (Settings -> Workspaces)
# is org-scoped and works either way.
#
# The data layer is ready: app/_lib/tenancy.ts classifies every declared table
# and assertTenancyReady() re-proves it at boot whenever this is on, so turning it
# on can only fail loudly. What still argues for OFF in production is that
# /api/workspace/export dumps the WHOLE database and /api/workspace/import
# self-refuses with 503 once this is set — i.e. enabling this disables restore —
# plus billing has no per-seat enforcement yet. See the Known gaps in
# docs/features/organization/README.md.
KP_MULTI_WORKSPACE=0
# Self-serve signup gate (app/_lib/workspace-lock.ts, signupEnabled). Default
# OFF: /signup and POST /api/auth/register answer 404 as if they didn't exist.
# Every registration provisions a brand-new org + team + owner, so turning it on
# means accepting strangers as tenants of this deployment: pair it with
# KP_MULTI_WORKSPACE and with a billing/abuse answer first. A commercial
# decision, not a build step.
KP_SIGNUP_ENABLED=0
# SQLite database file (all app data + candidate PII). REQUIRED to be an ABSOLUTE
# path in any deploy — the default is derived from the launch directory and a
# service/cron launched from elsewhere silently opens a DIFFERENT, empty DB
# (app/_lib/db-path.ts). The Docker image sets this to /data/kp.sqlite (a volume).
KP_DB_PATH=
# Database backend (docs/architecture/postgres-backend.md). Only 'sqlite' is implemented today;
# SQLite+WAL handles KP's concurrency. A Postgres backend (for multi-replica HA) is
# DESIGNED but unbuilt — setting KP_DB_BACKEND=postgres or a postgres:// DATABASE_URL
# fails fast with a pointer, on purpose, so a misconfig isn't silently ignored.
# KP_DB_BACKEND=sqlite
# DATABASE_URL=
# Host port the container publishes (docker-compose maps ${KP_PORT}:3000).
KP_PORT=3000
# Python interpreter the app spawns for the jobfit pipeline. The Docker image sets
# this to its venv (/opt/venv/bin/python); only override on a bespoke host.
# PYTHON_CMD=python3
# Next.js telemetry is disabled in the image; set here too for bare-metal runs.
NEXT_TELEMETRY_DISABLED=1
# Self-hosted / in-VPC inference (docs/architecture/self-hosting.md §5): point the OpenAI adapter
# at an OpenAI-compatible endpoint on your own network — Azure OpenAI, vLLM, Ollama
# (http://ollama:11434/v1), LiteLLM, a proxy — so model calls never leave your
# boundary. Then route use cases to the `openai` provider in Settings → Models.
# Runs KEYLESS against endpoints that need no key (vLLM/Ollama); set OPENAI_API_KEY
# above only if yours enforces one. Leave blank to use api.openai.com.
# OPENAI_BASE_URL=http://ollama:11434/v1
#
# --- First-run / onboarding dev switches -------------------------------------
# KP_EMPTY — skip ALL fixture content seeding at boot (demo jobs corpus, candidates,
# analyses, pipeline, example JD, seed org members) so the app starts as a truly
# blank tenant. Normally you don't set this by hand: `npm run dev:empty` sets it
# together with a throwaway KP_DB_PATH (data/kp-empty.sqlite, wiped each launch,
# port 3002) to preview the newcomer experience without touching your seeded DB.
# KP_EMPTY=0
# KP_FORCE_ONBOARDING — show the first-run onboarding wizard on EVERY load of /,
# regardless of the persisted completed/skipped state. Dev aid for iterating on the
# wizard against a seeded DB; `?onboarding=1` on / does the same for a single load.
# KP_FORCE_ONBOARDING=0

# KP_OFFLINE — hard no-egress mode (docs/architecture/self-hosting.md §7). Set to 1 and KP refuses
# EVERY outbound call except loopback + the private endpoints you configured above
# (OPENAI_BASE_URL / AZURE_OPENAI_ENDPOINT / LIGHTTRACK_URL / app origin). Cloud LLM
# engines fall back to deterministic; billing (Polar) is disabled. Belt-and-suspenders
# for an air-gapped install — still pair it with a network egress policy.
# KP_OFFLINE=0
# Extra hosts to allow through the offline guard (comma-separated) — e.g. a
# same-network model gateway or ATS relay not covered by the vars above.
# KP_OFFLINE_ALLOW_HOSTS=

# --- Google Calendar (W1.4) -------------------------------------------------
# Two-way scheduling: kp reads the connected calendar's FREE/BUSY so it never offers
# an interview slot the interviewer is already booked for, and writes the confirmed
# interview back as an event. Entirely optional — with these unset, scheduling behaves
# exactly as it did before (link-based slots, kp-side collision checks only).
#
# Create a Web OAuth 2.0 client in Google Cloud → APIs & Services → Credentials, and
# register this EXACT redirect URI (Google matches it verbatim, including port):
#   <your app origin>/api/calendar/google/callback
# GET /api/calendar/google echoes the exact string to register for this deployment.
#
# Scopes requested are deliberately the two NARROW ones — calendar.freebusy (whether
# you are busy, never what the meeting is) and calendar.events (to write the booking).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
#
# The stored refresh token is encrypted at rest under KP_ATS_SECRET_KEY (or KP_SECRET),
# the same key the ATS credentials use. Without one configured, kp REFUSES to store the
# token rather than persisting a calendar credential in clear.
