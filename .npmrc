# HISTORY: next was pinned to 16.3.0-canary.77 (Cache Components / instant
# navigations before they reached stable), and npm's semver rules exclude
# prereleases from peer ranges like next@"^16.0.0" — so a strict cold `npm ci`
# failed with ERESOLVE and this flag was required. next is now on STABLE 16.3.0,
# which peer ranges match, so the flag is no longer load-bearing for next itself.
# It stays (for now) because the Dockerfile also passes --legacy-peer-deps
# explicitly and the two install modes should move together; drop both in one
# change once a strict `npm ci` is verified clean.
# (package-lock.json still pins exact versions; this only disables peer checks.)
legacy-peer-deps=true
