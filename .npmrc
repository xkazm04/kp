# next is pinned to a canary (see package.json "next": "16.3.0-canary.77") for
# Cache Components / instant navigations. next-intl (and other deps) declare a
# peer range like next@"^16.0.0" that, by npm's semver rules, does NOT match a
# prerelease such as 16.3.0-canary.77 — so a strict cold `npm ci` fails with
# ERESOLVE even though the pinned tree installs and passes the full gate. Relax
# peer enforcement so CI resolves the same lockfile local dev already runs on.
# (package-lock.json still pins exact versions; this only disables peer checks.)
legacy-peer-deps=true
