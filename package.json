{
  "name": "kp",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xkazm04/kp.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "prepare": "node scripts/hooks/install.mjs",
    "hooks:install": "node scripts/hooks/install.mjs",
    "hooks:check": "node scripts/hooks/install.mjs --check",
    "dev": "node scripts/dev-guard.mjs next dev",
    "dev:empty": "node scripts/dev-empty.mjs",
    "dev:inspect": "cross-env DEV_INSPECT=1 DEV_GUARD_MAX_NODE=150 node scripts/dev-guard.mjs next dev",
    "dev:inspect:webpack": "cross-env DEV_INSPECT=1 DEV_INSPECT_BUNDLER=webpack DEV_GUARD_MAX_NODE=150 node scripts/dev-guard.mjs next dev --webpack",
    "build": "npm run schemas:gen && next build",
    "start": "next start",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "lint:ruff-ratchet": "node scripts/lint/ruff-ratchet.mjs",
    "lint:ts-ratchet": "node scripts/lint/ts-ratchet.mjs",
    "schemas:gen": "node scripts/schemas-gen.mjs",
    "schemas:check": "node scripts/schemas-gen.mjs --check",
    "taxonomy:check": "python -m pipeline.jobfit.taxonomy_check --check-report",
    "taxonomy:report": "python -m pipeline.jobfit.taxonomy_check --write-report",
    "typecheck": "npm run schemas:gen && npm run clean:tsbuildinfo && tsc --noEmit",
    "clean:tsbuildinfo": "node -e \"require('fs').rmSync('tsconfig.tsbuildinfo',{force:true})\"",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:python": "python -m unittest discover pipeline/jobfit/tests",
    "test:python:gate": "python -m pipeline.jobfit.tests.run_gated",
    "test:e2e": "playwright test",
    "test:eval": "python -m pipeline.jobfit.eval",
    "test:eval:strict": "python -m pipeline.jobfit.eval --strict",
    "test:eval:match": "python -m pipeline.jobfit.eval.matching_eval --strict",
    "test:eval:automation": "python -m pipeline.jobfit.eval.automation_eval --no-llm --strict",
    "test:eval:fault": "python -m pipeline.jobfit.eval.fault_eval --strict",
    "test:eval:ci": "npm run test:eval:match && npm run test:eval:automation && npm run test:eval:fault",
    "i18n:check": "node scripts/i18n-check.mjs",
    "docs:check": "node scripts/docs/check-adrs.mjs",
    "docs:check:diff": "node scripts/docs/check-doc-sync-diff.mjs",
    "guidance:check": "node scripts/docs/check-guidance.mjs",
    "test:docs": "node scripts/docs/__tests__/check-doc-sync.test.mjs && node scripts/docs/__tests__/check-adrs.test.mjs && node scripts/docs/__tests__/check-guidance.test.mjs && node scripts/__tests__/schemas-gen.test.mjs && node scripts/docs/__tests__/toolchain-pin.test.mjs && node scripts/docs/__tests__/keyless-e2e-pin.test.mjs",
    "release:check": "node scripts/release/prepare.mjs --check",
    "release:prepare": "node scripts/release/prepare.mjs",
    "commit:check": "node scripts/release/commit-msg.mjs",
    "provenance": "node scripts/release/provenance.mjs",
    "sbom": "node scripts/release/sbom.mjs",
    "test:release": "node scripts/release/__tests__/prepare.test.mjs && node scripts/release/__tests__/commit-msg.test.mjs && node scripts/release/__tests__/sbom.test.mjs && node scripts/release/__tests__/provenance.test.mjs",
    "review:constitution": "node scripts/review/constitution-check.mjs",
    "review:agent": "node scripts/review/agent-review.mjs",
    "review:gate": "node scripts/review/gate-check.mjs",
    "agent:dispatch": "node scripts/agent/dispatch.mjs",
    "ci:budget": "node scripts/perf/ci-budget.mjs",
    "perf:budget": "node scripts/perf/check-budget.mjs",
    "test:perf": "node scripts/perf/__tests__/ci-budget.test.mjs && node scripts/perf/__tests__/check-budget.test.mjs",
    "security:actions": "node scripts/security/check-actions.mjs",
    "security:secrets": "node scripts/security/secret-scan.mjs",
    "test:security": "node scripts/security/__tests__/secret-scan.test.mjs && node scripts/security/__tests__/check-actions.test.mjs",
    "deploy:check": "node scripts/deploy/check-chart.mjs",
    "test:deploy": "node scripts/deploy/__tests__/check-chart.test.mjs",
    "test:skills": "node --test \".claude/skills/motionize/tools/__tests__/*.test.mjs\"",
    "test:review": "node scripts/review/__tests__/constitution-check.test.mjs && node scripts/review/__tests__/gate-check.test.mjs && node scripts/review/__tests__/workflow-yaml.test.mjs && node scripts/review/__tests__/agent-review.test.mjs",
    "test:agent": "node scripts/agent/__tests__/dispatch.test.mjs && node scripts/agent/__tests__/provenance.test.mjs && node scripts/agent/__tests__/budget.test.mjs",
    "test:lint-ratchet": "node scripts/lint/__tests__/ruff-ratchet.test.mjs && node scripts/lint/__tests__/ts-ratchet.test.mjs",
    "bench:app-master": "node scripts/app-master-bench/run.mjs --all --report",
    "bench:gate": "node scripts/app-master-bench/gate.mjs",
    "test:bench-driver": "node scripts/run-unit-tests.mjs \"scripts/app-master-bench/**/*.test.mjs\"",
    "design:check": "node scripts/design/check-design-tokens.mjs",
    "onboard:ui": "node scripts/onboard-ui/server.mjs",
    "polar:setup": "node --import ./scripts/test-alias-loader.mjs --experimental-transform-types --disable-warning=ExperimentalWarning scripts/polar-setup.mjs",
    "market:build": "node scripts/build-market-pulse.mjs",
    "market:earnings": "node scripts/refresh-market-earnings.mjs",
    "market:apply": "node scripts/apply-market-salaries.mjs",
    "pipeline:sample": "python -m pipeline.jobfit.cli samples/sample-cv.txt",
    "db:dump": "node scripts/db-dump.mjs",
    "db:load": "node scripts/db-load.mjs",
    "secrets:rotate": "node scripts/secrets-rotate.mjs",
    "db:pg-audit": "node --import ./scripts/test-alias-loader.mjs --experimental-transform-types --disable-warning=ExperimentalWarning scripts/pg-portability-audit.mjs"
  },
  "dependencies": {
    "@elevenlabs/react": "^1.13.0",
    "@google/genai": "^1.52.0",
    "@sentry/nextjs": "^10.71.0",
    "@tailwindcss/forms": "^0.5.11",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "elkjs": "^0.11.1",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.14.0",
    "next": "16.3.3",
    "next-intl": "^4.13.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "^7.29.7",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.5.4",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.3",
    "eslint-plugin-i18next": "^6.1.5",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
