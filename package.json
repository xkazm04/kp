{
  "name": "kp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run schemas:gen && next build",
    "start": "next start",
    "lint": "eslint .",
    "schemas:gen": "python -m pipeline.jobfit.codegen",
    "schemas:check": "python -m pipeline.jobfit.codegen --check",
    "typecheck": "npm run schemas:gen && tsc --noEmit",
    "test:python": "python -m unittest discover pipeline/jobfit/tests",
    "test:e2e": "playwright test",
    "test:eval": "python -m pipeline.jobfit.eval",
    "test:eval:strict": "python -m pipeline.jobfit.eval --strict",
    "pipeline:sample": "python -m pipeline.jobfit.cli samples/sample-cv.txt"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@tailwindcss/forms": "^0.5.11",
    "better-sqlite3": "^12.9.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "recharts": "^3.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3"
  }
}
