{
  "name": "kp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-guard.mjs next dev",
    "dev:inspect": "cross-env DEV_INSPECT=1 DEV_GUARD_MAX_NODE=150 node scripts/dev-guard.mjs next dev --webpack",
    "build": "npm run schemas:gen && next build",
    "start": "next start",
    "lint": "eslint .",
    "schemas:gen": "python -m pipeline.jobfit.codegen",
    "schemas:check": "python -m pipeline.jobfit.codegen --check",
    "typecheck": "npm run schemas:gen && tsc --noEmit",
    "test:unit": "node --import ./scripts/test-alias-loader.mjs --experimental-transform-types --disable-warning=ExperimentalWarning --test \"app/**/*.test.ts\"",
    "test:python": "python -m unittest discover pipeline/jobfit/tests",
    "test:python:gate": "python -m pipeline.jobfit.tests.run_gated",
    "test:e2e": "playwright test",
    "test:eval": "python -m pipeline.jobfit.eval",
    "test:eval:strict": "python -m pipeline.jobfit.eval --strict",
    "test:eval:match": "python -m pipeline.jobfit.eval.matching_eval --strict",
    "i18n:check": "node scripts/i18n-check.mjs",
    "pipeline:sample": "python -m pipeline.jobfit.cli samples/sample-cv.txt",
    "db:dump": "node scripts/db-dump.mjs",
    "db:load": "node scripts/db-load.mjs"
  },
  "dependencies": {
    "@elevenlabs/react": "^1.6.4",
    "@google/genai": "^1.52.0",
    "@tailwindcss/forms": "^0.5.11",
    "better-sqlite3": "^12.9.0",
    "clsx": "^2.1.1",
    "elkjs": "^0.11.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "next": "^16.2.4",
    "next-intl": "^4.13.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "recharts": "^3.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@babel/core": "^7.29.7",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "eslint-plugin-i18next": "^6.1.4",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3"
  }
}
