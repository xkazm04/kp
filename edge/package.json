{
  "name": "kp-edge",
  "private": true,
  "version": "0.1.0",
  "description": "Store-and-forward edge for a local-first KP install (deploy to your own Cloudflare account)",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "test": "node --experimental-transform-types --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "schema": "wrangler d1 execute kp-edge --remote --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260831.1",
    "typescript": "^7.0.2",
    "wrangler": "^4"
  }
}
